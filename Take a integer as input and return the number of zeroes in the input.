import java.util.*;

public class Main {
    public static void main(String[] args) {
      Scanner sc = new Scanner(System.in);
      int n = sc.nextInt();
      String nString = String.valueOf(n);
      int zeroCount = 0;
      for(int i = 0; i < nString.length(); i++){
        if(nString.charAt(i) == '0'){
          zeroCount++;
        }
      }
      System.out.println(zeroCount);
      sc.close();
  }
}
